# Embedding provider selection for manual experiments
# EMBEDDING_PROVIDER=mock
# EMBEDDING_PROVIDER=local
# EMBEDDING_PROVIDER=openai
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_PROVIDER=openrouter

# Optional: set cache directories for the local multilingual embedder
# HF_HOME=./.hf-cache
# SENTENCE_TRANSFORMERS_HOME=./.sentence-transformers

# Optional: OpenAI embedding configuration
# OPENAI_API_KEY=your-key-here
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: Gemini embedding configuration
# GEMINI_API_KEY=your-key-here
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# GEMINI_EMBEDDING_DIMENSIONS=768

# OpenRouter: embeddings and answer generation use different model types
# OPENROUTER_API_KEY=your-key-here
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# OPENROUTER_EMBEDDING_DIMENSIONS=768
# LLM_PROVIDER=openrouter
# OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
# OPENROUTER_SITE_URL=http://localhost
# OPENROUTER_APP_NAME=K4 RAG Lab

# Heading-based chunking used by main.py
# HEADING_CHUNK_SIZE=1000

# Supabase vector store (keep the service-role key server-side only)
# VECTOR_STORE_PROVIDER=supabase
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_VECTOR_DIMENSIONS=768

# Optional: for ChromaDB persistence (bonus task)
# CHROMA_PERSIST_DIR=./chroma_data
